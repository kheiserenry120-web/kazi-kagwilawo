@using Microsoft.AspNetCore.Identity
@using KaziKagwilawo.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var fullName = User.FindFirst("FullName")?.Value ?? user?.FirstName ?? User.Identity?.Name?.Split('@')[0];
    
    <li class="nav-item dropdown">
        <a class="nav-link" href="#" id="settingsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-gear-fill settings-gear"></i>
        </a>
        <div class="dropdown-menu dropdown-menu-end settings-dropdown shadow-lg" aria-labelledby="settingsDropdown">
            <!-- User Header -->
            <div class="dropdown-header-custom">
                <div class="d-flex align-items-center">
                    <img src="https://ui-avatars.com/api/?name=@fullName&background=0D6EFD&color=fff&size=64" 
                         alt="User" class="rounded-circle shadow-sm me-3" width="48" height="48">
                    <div>
                        <h6 class="mb-0 fw-bold">Hello @fullName 👋</h6>
                        <small class="text-muted">@(user?.Email ?? "user@example.com")</small>
                    </div>
                </div>
            </div>

            <!-- Menu Links -->
            <div class="py-2">
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                    <i class="bi bi-person"></i> Profile
                </a>
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication">
                    <i class="bi bi-shield-lock"></i> Security
                </a>
                <a class="dropdown-item" href="#">
                    <i class="bi bi-bell"></i> Notifications
                </a>
                
                <div class="dropdown-divider mx-3"></div>
                
                <div class="dropdown-item py-2 px-4">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-moon-stars m-0 me-3"></i> Dark Mode
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="darkModeToggle">
                        </div>
                    </div>
                </div>

                <a class="dropdown-item" href="#">
                    <i class="bi bi-question-circle"></i> Help & Support
                </a>

                <div class="dropdown-divider mx-3"></div>

                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="dropdown-item text-danger">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </div>
        </div>
    </li>
}
else
{
    <li class="nav-item me-2">
        <a class="nav-link fw-medium text-dark px-3" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
    <li class="nav-item">
        <a class="nav-link btn btn-signup px-4 rounded-pill shadow-sm" asp-area="Identity" asp-page="/Account/Register">Sign Up</a>
    </li>
}
</ul>
